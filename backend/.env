# Configuración del servidor
PORT=5000
NODE_ENV=development

# URL del cliente (React app)
CLIENT_URL=http://localhost:3000

# API Key de Google Gemini
# Obtén tu API key desde: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyDY3edohMdSvq36nlv6zc5vRhhvFiZxtAE

# Configuración de base de datos (opcional, para logs)
# DATABASE_URL=mongodb://localhost:27017/password-generator

# Configuración de seguridad
JWT_SECRET=your_jwt_secret_here
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Configuración de logs
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Límites de rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
PASSWORD_RATE_LIMIT_WINDOW_MS=300000
PASSWORD_RATE_LIMIT_MAX_REQUESTS=10